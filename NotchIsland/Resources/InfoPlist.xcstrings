    "NSAppleEventsUsageDescription" : {
      "comment" : "Privacy - AppleEvents Sending Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NotchIsland reads the current song from Spotify, Music and YouTube in your browser, controls playback, asks Finder to empty the Trash from the Storage tab, and asks Microsoft Word to turn Word documents into PDF."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NotchIsland membaca lagu yang sedang diputar dari Spotify, Music, dan YouTube di browser, mengontrol pemutarannya, meminta Finder mengosongkan Tong Sampah dari tab Penyimpanan, serta meminta Microsoft Word mengubah dokumen Word menjadi PDF."
          }
        }
      }
    },
    "NSCameraUsageDescription" : {
      "comment" : "Privacy - Camera Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NotchIsland shows a live camera mirror in the Camera tab. Video is never recorded or sent anywhere."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NotchIsland menampilkan cermin kamera langsung di tab Kamera. Video tidak pernah direkam atau dikirim ke mana pun."
          }
        }
      }
    }
  },
  "version" : "1.0"
}
