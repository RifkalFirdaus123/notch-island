        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lirik diambil dari LRCLIB; hanya judul, artis, album, dan durasi lagu yang dikirim. Gambar kamera tidak pernah direkam atau disimpan."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lyrics come from LRCLIB; only the song title, artist, album and length are sent. The camera picture is never recorded or stored."
